{
  "$schema": "https://schema.tauri.app/v2/config.json",
  "productName": "NetPulse",
  "version": "1.0.0",
  "identifier": "com.netpulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetPulse — Network Diagnostics Workstation",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' https: data:; img-src 'self' data: https:; connect-src 'self' https: http:; font-src 'self' https: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NetPulse Core Engineering Team",
    "copyright": "Copyright © 2026 NetPulse Team. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Zero-Elevation Network Diagnostics & Geolocation Workstation",
    "longDescription": "NetPulse is an ultra-fast, zero-elevation desktop network workstation featuring visual traceroute, continuous ping sparklines, high-speed port scanning, DNS propagation inspection, WHOIS/RDAP queries, and CIDR calculators.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": null
    }
  }
}
